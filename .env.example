# ---------------------------------------------------------------------------
# Source
# ---------------------------------------------------------------------------
# The Wispr Flow application-support directory. Leave blank to auto-detect:
#   macOS    ~/Library/Application Support/Wispr Flow
#   Windows  %APPDATA%\Wispr Flow
#   Linux    ~/.config/Wispr Flow
WISPR_DATA_DIR=

# The SQLite database. Defaults to <data dir>/flow.sqlite.
# Point this at a backups/backup-*.sqlite or a Time Machine copy to read a
# snapshot instead; those are opened with ?immutable=1, because their -shm and
# -wal siblings are misnamed and a plain read-only open fails SQLITE_CANTOPEN.
WISPR_DB_PATH=

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# local  read only the on-disk database and files (always works, no network)
# cloud  read only api.wisprflow.ai (undocumented private API; may break)
# both   local first, then cloud for anything local cannot see
# auto   the local store only. The cloud backend is never reached without
#        Values: all, local, cloud, mcp, both, auto.
#
#        "all" is the default: local always, plus cloud and MCP wherever a
#        credential exists. Every run prints which backends it will contact
#        before contacting any of them, and a backend with no credential is
#        skipped rather than reported as a failure.
#
#        Naming one explicitly (e.g. --source mcp) makes a missing credential
#        an error instead of a skip, which is what a scripted run wants.
#
#        "local" touches no network at all. "auto" is local-only too, kept for
#        anyone who wants the pre-0.3.0 default back. "both" is local + cloud.
WISPR_SYNC_SOURCE=all

# ---------------------------------------------------------------------------
# Archive
# ---------------------------------------------------------------------------
# Where the archive is written. Relative paths resolve from the repo root.
WISPR_ARCHIVE_DIR=./archive

# Comma list, or "all". Valid: meetings, notes, todos, dictionary, calendar,
# dictation, account, tables
WISPR_ENTITIES=all

# ---------------------------------------------------------------------------
# Media and sensitive blobs
# ---------------------------------------------------------------------------
# copy  archive upload.ogg (~16 MB/meeting). The default, because Wispr Flow
#       garbage-collects meeting audio -- on the machine this was written
#       against, only 1 of 3 meetings still had its audio on disk, so "link"
#       would record a pointer to a file that is already gone.
# link  record path, size and hash only
# skip  ignore audio entirely
WISPR_AUDIO=copy
WISPR_MAX_AUDIO_MB=512

# Dictation audio blobs (History.audio, History.builtInAudio) and images
# pasted into scratchpad notes. Off by default; these are large.
WISPR_INCLUDE_AUDIO_BLOBS=0
WISPR_INCLUDE_IMAGES=0

# Screen context: the screenshot, axText and axHTML columns of BOTH History
# and FlowLensHistory. These are a bitmap and a full accessibility-tree
# capture of whatever application had focus at the moment you spoke, which can
# be a password manager, a banking session or someone else's screen on a
# shared call. Off by default, and the CLI additionally requires
# --i-understand before it will widen the export this far.
WISPR_INCLUDE_SCREEN_CONTEXT=0

# ---------------------------------------------------------------------------
# Sync behavior
# ---------------------------------------------------------------------------
# Trailing days re-read on every run for tables that record no modification
# time. History rows are edited in place after creation with no modifiedAt, so
# a pure watermark would miss the edit.
WISPR_RECHECK_DAYS=14

# Exit 3 on additive schema drift instead of warning. Off by default: Wispr
# Flow ships roughly 20 migrations a month, so a non-zero exit on every new
# column would train you to ignore the exit code entirely -- and then to
# ignore the breaking-drift code too.
WISPR_STRICT_SCHEMA=0

# ---------------------------------------------------------------------------
# Cloud backend (optional, undocumented private API)
# ---------------------------------------------------------------------------
WISPR_API_BASE=https://api.wisprflow.ai

# Where session.json lives. Defaults to <data dir>/session.json.
# This tool READS it and never writes to it. It also never calls the Supabase
# refresh endpoint: GoTrue rotates refresh tokens and detects reuse, so a
# second client that refreshes would invalidate the desktop app's own session
# and sign you out of Wispr Flow. When the access token has expired, open
# Wispr Flow -- which refreshes it itself -- and re-run.
WISPR_SESSION_FILE=

# ---------------------------------------------------------------------------
# MCP backend (optional, Wispr Flow's remote MCP server)
# ---------------------------------------------------------------------------
# The one backend this tool holds a credential for. Unlike the sync API, the
# MCP server is a separate OAuth resource with a separate issuer, and it
# rejects the desktop app's token -- so there is nothing to borrow. Authorize
# once with `wispr-export login`; discard with `wispr-export logout`.
#
# The token is stored at ~/.config/wispr-flow-exporter/mcp-token.json, mode
# 0600, deliberately outside the archive so an archive you copy or share still
# carries no credential. XDG_CONFIG_HOME is honored when set.
WISPR_MCP_ENDPOINT=https://api.wisprflow.ai/connect/mcp

# Skip the login flow entirely by supplying a token yourself. Mostly useful for
# testing; a token obtained this way still expires, and nothing refreshes it.
WISPR_MCP_TOKEN=

# Bypass session.json entirely with a bearer token (CI, containers, or any
# machine without Wispr Flow installed). Read at the call site and never
# written anywhere.
WISPR_ACCESS_TOKEN=
